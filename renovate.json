{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customDatasources": {
    "mysql-lts": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/docker-library/official-images/master/library/mysql",
      "format": "plain",
      "transformTemplates": [
        "( $ltsLine := releases.version[$substring($, 0, 6) = 'Tags: ' and $contains(', ' & $substringAfter($, 'Tags: ') & ', ', ', lts, ')][0]; $minor := $split($substringAfter($ltsLine, 'Tags: '), ', ')[$match($, /^\\d+\\.\\d+$/)][0]; { 'releases': $minor ? [{ 'version': $minor }] : [] } )"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/ruby/tasks/main.yml/"
      ],
      "datasourceTemplate": "ruby-version",
      "depNameTemplate": "ruby",
      "matchStrings": [
        "ruby-install (?<currentValue>[0-9]*.[0-9]*.[0-9]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/ruby/tasks/main.yml/"
      ],
      "datasourceTemplate": "ruby-version",
      "depNameTemplate": "ruby",
      "matchStrings": [
        "ruby_version_output.stdout != \"(?<currentValue>[0-9]*.[0-9]*.[0-9]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/golang/tasks/main.yml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "go(?<currentValue>[0-9]*.[0-9]*.[0-9]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/codeql.yml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "go-version: \"?(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/osv-scanner.toml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "GoVersionOverride = \"?(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/python/tasks/main.yml/"
      ],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python",
      "matchStrings": [
        "python-install (?<currentValue>[0-9]*.[0-9]*.[0-9]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/python/tasks/main.yml/"
      ],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python",
      "matchStrings": [
        "python_version_output.stdout != \"Python (?<currentValue>[0-9]*.[0-9]*.[0-9]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/php/tasks/main.yml/"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "php/php-src",
      "extractVersionTemplate": "^php-(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "matchStrings": [
        "php-install (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/php/tasks/main.yml/"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "php/php-src",
      "extractVersionTemplate": "^php-(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "matchStrings": [
        "php_version_output\\.stdout != \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/nodejs/tasks/main.yml/"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "matchStrings": [
        "node-install v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/roles/nodejs/tasks/main.yml/"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "matchStrings": [
        "nodejs_version_output\\.stdout != \"v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^webapp\\/compose\\.yml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+mysql:[ \\t]*\\r?\\n[ \\t]+image:[ \\t]*mysql:(?<currentValue>\\d+\\.\\d+)[ \\t]*(?:#.*)?(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "mysql",
      "datasourceTemplate": "custom.mysql-lts",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nginx"
      ],
      "versioning": "regex:^(?<major>[0-9]+)\\.(?<minor>[0-9]*[02468])(?<patch>\\d*)$"
    },
    {
      "description": [
        "Let the custom datasource manage the MySQL LTS version in Docker Compose."
      ],
      "matchManagers": [
        "docker-compose"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "matchFileNames": [
        "webapp/compose.yml"
      ],
      "enabled": false
    },
    {
      "description": [
        "The MySQL LTS custom datasource does not provide release timestamps, so override any minimumReleaseAge setting; otherwise Renovate treats its updates as permanently pending."
      ],
      "matchDatasources": [
        "custom.mysql-lts"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "matchFileNames": [
        "webapp/compose.yml"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/go/go.mod",
        "webapp/go/go.sum"
      ],
      "branchTopic": "go-lock-file-maintenance",
      "commitMessageTopic": "Go lock file"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/ruby/Gemfile",
        "webapp/ruby/Gemfile.lock"
      ],
      "branchTopic": "ruby-lock-file-maintenance",
      "commitMessageTopic": "Ruby lock file"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/php/composer.json",
        "webapp/php/composer.lock"
      ],
      "branchTopic": "php-lock-file-maintenance",
      "commitMessageTopic": "PHP lock file"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/nodejs/package.json",
        "webapp/nodejs/package-lock.json"
      ],
      "branchTopic": "nodejs-lock-file-maintenance",
      "commitMessageTopic": "Node.js lock file"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/python/pyproject.toml",
        "webapp/python/uv.lock"
      ],
      "branchTopic": "python-lock-file-maintenance",
      "commitMessageTopic": "Python lock file"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
